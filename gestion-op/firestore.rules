rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  FONCTIONS D'ACCÈS
    //
    //  Principe : être authentifié ne suffit PAS. L'inscription Firebase
    //  étant ouverte (et la clé publique visible dans le code envoyé au
    //  navigateur), n'importe qui peut créer un compte de connexion.
    //  L'accès aux données exige donc un profil créé par un administrateur
    //  ET encore actif.
    // ============================================================
    function profil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function aUnProfil() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isConnected() {
      return aUnProfil() && profil().actif != false;
    }

    function getUserRole() {
      return profil().role;
    }

    function isAdmin() {
      return isConnected() && getUserRole() == 'ADMIN';
    }

    function isOperateur() {
      return isConnected() && getUserRole() in ['ADMIN', 'OPERATEUR', 'SAISIE', 'CF', 'AC'];
    }

    // ============================================================
    //  COLLECTION : users (gestion des comptes)
    //  → Chacun lit son propre profil, l'ADMIN lit tout l'annuaire
    //  → Seul un ADMIN crée un profil : plus personne ne peut se
    //    fabriquer un rôle en contournant l'application
    // ============================================================
    match /users/{userId} {
      // Volontairement basé sur request.auth et non isConnected() : lire son
      // propre profil est l'étape qui permet justement de l'évaluer.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow create: if isAdmin();

      // Un utilisateur peut corriger son propre profil, mais ne peut changer
      // ni son rôle ni son statut actif (sinon il se réactiverait lui-même).
      allow update: if isAdmin()
        || (request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.actif == resource.data.actif);

      allow delete: if isAdmin();
    }

    // ============================================================
    //  COLLECTION : parametres (configuration du projet)
    //  → Tout utilisateur autorisé peut lire (entêtes d'impression, sigle…)
    //  → Seul un ADMIN peut modifier
    // ============================================================
    match /parametres/{docId} {
      allow read: if isConnected();
      allow write: if isAdmin();
    }

    // ============================================================
    //  COLLECTIONS : sources, exercices, lignesBudgetaires
    //  (configuration budgétaire)
    // ============================================================
    match /sources/{docId} {
      allow read: if isConnected();
      allow write: if isOperateur();
    }

    match /exercices/{docId} {
      allow read: if isConnected();
      allow write: if isOperateur();
    }

    match /lignesBudgetaires/{docId} {
      allow read: if isConnected();
      allow write: if isOperateur();
    }

    // ============================================================
    //  COLLECTION : beneficiaires
    // ============================================================
    match /beneficiaires/{docId} {
      allow read: if isConnected();
      allow write: if isOperateur();
    }

    // ============================================================
    //  COLLECTION : budgets
    // ============================================================
    match /budgets/{docId} {
      allow read: if isConnected();
      allow write: if isOperateur();
    }

    // ============================================================
    //  COLLECTION : ops (ordres de paiement)
    //  → La suppression définitive est interdite : l'application n'efface
    //    jamais un OP, elle le passe au statut SUPPRIME (corbeille).
    //    Interdire delete empêche de contourner la corbeille et le journal.
    // ============================================================
    match /ops/{docId} {
      allow read: if isConnected();
      allow create, update: if isOperateur();
      allow delete: if false;
    }

    // ============================================================
    //  COLLECTION : bordereaux
    //  (la suppression reste autorisée : elle est utilisée par les
    //   circuits CF et AC pour annuler un bordereau non transmis)
    // ============================================================
    match /bordereaux/{docId} {
      allow read: if isConnected();
      allow write: if isOperateur();
    }

    match /compteurs/{docId} {
      allow read: if isConnected();
      allow write: if isOperateur();
    }

    // ============================================================
    //  COLLECTION : journal (historique des actions sur les OP)
    //  → Seul un ADMIN peut consulter le journal
    //  → ADMIN et OPERATEUR peuvent y ajouter une entrée (jamais la modifier/supprimer)
    // ============================================================
    match /journal/{docId} {
      allow read: if isAdmin();
      allow create: if isOperateur();
      allow update, delete: if false;
    }
  }
}
