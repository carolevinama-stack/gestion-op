# ============================================================
#  VARIABLES D'ENVIRONNEMENT — modèle
# ============================================================
#
#  Copier ce fichier en .env.local pour un développement sur poste,
#  ou reporter ces variables dans les réglages de l'hébergeur.
#
#  ⚠️ NE JAMAIS mettre de vraies valeurs dans CE fichier : il est
#  suivi par git. Les vraies valeurs vont dans .env.local, que le
#  .gitignore écarte.
#
#  ⚠️ Ces variables sont inscrites dans les fichiers AU MOMENT DE LA
#  COMPILATION, pas lues à l'ouverture. Changer une valeur impose donc
#  de recompiler.
# ============================================================


# ---------- Base de données ----------

# Adresse du projet Supabase.
# Où la trouver : Supabase → Settings → API (ou Data API).
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé PUBLIABLE (anciennement « anon »).
# Où la trouver : Supabase → Settings → API Keys → Publishable key.
#
# Elle est publique par conception : elle se trouve dans le code envoyé
# à chaque navigateur. Ce ne sont pas les clés qui protègent les données,
# ce sont les règles d'accès de supabase/securite.sql.
#
# 🚫 NE JAMAIS utiliser ici la clé SECRÈTE (sb_secret_... ou
# service_role) : elle contourne toutes les règles de sécurité et n'a
# rien à faire dans un navigateur.
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx


# ---------- Affichage ----------

# Affiche le bandeau « DÉMO » en haut de l'application.
# À mettre à true sur un environnement de test ou de démonstration,
# et à laisser absent en production.
REACT_APP_MODE_DEMO=true
