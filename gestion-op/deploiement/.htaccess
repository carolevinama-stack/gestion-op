# ============================================================
#  Apache / cPanel — à déposer À LA RACINE du site, à côté de index.html
# ============================================================
#
#  POURQUOI CE FICHIER EST INDISPENSABLE
#
#  L'application n'a qu'une seule vraie page : index.html. Les écrans
#  (budget, liste des OP, rapport...) sont affichés par le navigateur,
#  pas par le serveur.
#
#  À SAVOIR, et c'est rassurant : l'application n'utilise AUCUN routeur.
#  Les écrans changent par l'état interne de React et l'adresse ne quitte
#  jamais la racine, donc F5 recharge toujours la racine. Ce fichier est
#  un filet de sécurité (adresse mal tapée, favori périmé), pas une
#  nécessité — contrairement à ce que je croyais avant de l'éprouver.
#
#  VÉRIFIÉ contre un vrai Apache : /budget et /circuitCF servent bien le
#  même contenu que la racine, le script compilé est mis en cache un an,
#  index.html ne l'est jamais.
#
#  La règle ci-dessous dit au serveur : « si le fichier demandé n'existe
#  pas, sers index.html ». C'est l'équivalent exact de la section
#  "rewrites" du fichier vercel.json.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Les fichiers et dossiers qui existent vraiment sont servis tels quels
  # (les scripts, les styles, les images).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste est confié à l'application.
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------
#  Mise en cache
# ------------------------------------------------------------
#  Les fichiers de build portent une empreinte dans leur nom
#  (main.4f2a1b.js) : un changement produit un nouveau nom. Ils peuvent
#  donc être gardés longtemps sans risque.
#
#  index.html, lui, ne doit JAMAIS être mis en cache : c'est lui qui
#  désigne les fichiers à charger. Mis en cache, il continuerait de
#  désigner l'ancienne version après une mise à jour — les collègues
#  verraient encore l'ancienne application.
# ------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff|woff2|ttf|eot|png|jpe?g|gif|svg|ico|webp)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------
#  SI L'APPLICATION EST DANS UN SOUS-DOSSIER
# ------------------------------------------------------------
#  Par exemple https://apps.projet.org/gestion-op/ et non la racine.
#
#  1. Ajouter "homepage": "." dans package.json AVANT de compiler, sans
#     quoi le navigateur cherche les scripts à la racine du domaine et
#     l'application s'ouvre sur une page blanche, sans message d'erreur.
#  2. Remplacer la ligne RewriteBase ci-dessus par :
#
#         RewriteBase /gestion-op/
#
#  3. Et la dernière RewriteRule par :
#
#         RewriteRule ^ /gestion-op/index.html [L]
#
#  Ce cas a été vérifié : les écrans et le script principal répondent
#  tous correctement depuis un sous-dossier.
# ------------------------------------------------------------
